# ─── Growcad Environment Variables ────────────────────────────────────────────
# Copy to .env.local for development. Never commit .env.local.
#
# DEPLOYMENT MODE
# ────────────────
# Leave NEXT_PUBLIC_API_URL empty → uses built-in Next.js API routes (/app/api/*)
# Set NEXT_PUBLIC_API_URL to a full origin → proxies all API calls to that server
#   Correct:   NEXT_PUBLIC_API_URL=https://api.growcad.in
#   Wrong:     NEXT_PUBLIC_API_URL=https://api.growcad.in/api   ← adds /api twice

NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=https://app.growcad.in
NEXT_PUBLIC_LAND_URL=https://growcad.in

# ─── Database (Supabase) ───────────────────────────────────────────────────────
# Use the DIRECT connection string (port 5432), NOT the pooler (port 6543).
# The pooler (PgBouncer) breaks Prisma migrations and prepared statements.
#
# Find in: Supabase dashboard → Project Settings → Database → Connection string
# Select "URI" and make sure it shows port 5432.
#
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a random 64-char secret: openssl rand -hex 32
JWT_SECRET=your-64-char-random-secret-here

# ─── SMS / OTP (MSG91) ────────────────────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_TEMPLATE_SMS_ID=
MSG91_TEMPLATE_WA_ID=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx

# ─── Payments (Razorpay) ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── AI (Google Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── Storage (Cloudflare R2) ──────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=growcad-files
R2_PUBLIC_URL=https://files.growcad.in

# ─── Cron security ────────────────────────────────────────────────────────────
# Used by Vercel cron jobs to authenticate /api/cron/* routes
CRON_SECRET=your-cron-secret-here
